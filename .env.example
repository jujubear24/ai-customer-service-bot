# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=YOUR-NEW-ACCOUNT-ID  # Update this

# Environment
ENVIRONMENT=dev

# These will be populated as you deploy more resources later
CONVERSATIONS_TABLE=ai-customer-service-conversations-dev
REDIS_ENDPOINT=your-redis-endpoint
OPENSEARCH_ENDPOINT=your-opensearch-endpoint
KNOWLEDGE_BASE_ID=your-knowledge-base-id
API_GATEWAY_URL=https://your-api-gateway-url
COGNITO_USER_POOL_ID=your-user-pool-id
COGNITO_CLIENT_ID=your-client-id
